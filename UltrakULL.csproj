<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ULTRAKILLPath Condition="'$(ULTRAKILLPath)' == ''">E:\SteamLibrary\steamapps\common\ULTRAKILL</ULTRAKILLPath>
    <ManagedDir>$(ULTRAKILLPath)\ULTRAKILL_Data\Managed</ManagedDir>
    <BepInExCoreDir>$(ULTRAKILLPath)\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>

  <!-- Build settings -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>UltrakULL</AssemblyName>
    <RootNamespace>UltrakULL</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>0168;0169;0219;0414;0618;0649;1998;4014</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath></Reference>
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <Reference Include="$(ManagedDir)\UnityEngine*.dll" />
    <Reference Include="$(ManagedDir)\Unity.*.dll" />
    
    <Publicize Include="Assembly-CSharp" />
  </ItemGroup>

  <!-- Embedded resources -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\SubtitledSources.json" LogicalName="UltrakULL.SubtitledSources.json" />
  </ItemGroup>

  <!-- Fail early with a clear message if the game path is wrong -->
  <Target Name="CheckGamePath" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(ManagedDir)')"
           Text="ULTRAKILL not found at '$(ULTRAKILLPath)'. Set the ULTRAKILLPath property to your install location." />
  </Target>

  <!-- Package into a BepInEx-ready layout: <out>/plugins/UltrakULL + <out>/config/ultrakull.
       Copy/Move create their destination folders, so no MakeDir step is needed. -->
  <Target Name="Package" AfterTargets="Build">
    <ItemGroup>
      <_JsonTemplates Include="$(ProjectDir)UltrakULL\json\templates\*.json" />
      <_AudioTemplates Include="$(ProjectDir)UltrakULL\audio\templates\**\*.*" />
    </ItemGroup>

    <Move SourceFiles="$(TargetDir)UltrakULL.dll" DestinationFolder="$(TargetDir)plugins\UltrakULL" />
    <Copy SourceFiles="@(_JsonTemplates)" DestinationFolder="$(TargetDir)config\ultrakull" />
    <Copy SourceFiles="@(_AudioTemplates)" DestinationFolder="$(TargetDir)config\ultrakull\audio\%(RecursiveDir)" />
  </Target>

  <!-- Copies the .dll and .pdb complied to (ULTRAKILLDIR)/BepInEx/plugins/UltrakULL -->
  <PropertyGroup>
    <DeployToGame Condition="'$(DeployToGame)' == ''">true</DeployToGame>
    <GamePluginDir>$(ULTRAKILLPath)\BepInEx\plugins\UltrakULL</GamePluginDir>
  </PropertyGroup>

  <Target Name="DeployToGame" AfterTargets="Package"
          Condition="'$(DeployToGame)' == 'true' AND Exists('$(ULTRAKILLPath)\BepInEx')">
    <Copy SourceFiles="$(TargetDir)plugins\UltrakULL\UltrakULL.dll" DestinationFolder="$(GamePluginDir)" />
    <Copy Condition="Exists('$(TargetDir)UltrakULL.pdb')"
          SourceFiles="$(TargetDir)UltrakULL.pdb" DestinationFolder="$(GamePluginDir)" />
    <Message Importance="high" Text="Deployed UltrakULL.dll -> $(GamePluginDir)" />
  </Target>

  <!-- In Release, strip stray root files so the output folder is a clean drop-in -->
  <Target Name="CleanRoot" AfterTargets="Package" Condition="'$(Configuration)' == 'Release'">
    <RemoveDir Directories="$(TargetDir)net472;$(TargetDir)publish" />
    <ItemGroup>
      <_StrayRootFiles Include="$(TargetDir)*.*" />
    </ItemGroup>
    <Delete Files="@(_StrayRootFiles)" />
  </Target>

</Project>
